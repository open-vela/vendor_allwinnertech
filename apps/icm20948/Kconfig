#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_ICM20948
	bool "ICM20948 sensor example"
	default n
	---help---
		Enable the ICM20948 sensor example

if EXAMPLES_ICM20948

config EXAMPLES_ICM20948_PROGNAME
	string "Program name"
	default "icm20948_uorb"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config EXAMPLES_ICM20948_PRIORITY
	int "ICM20948 task priority"
	default 100

config EXAMPLES_ICM20948_STACKSIZE
	int "ICM20948 stack size"
	default 2048

config EXAMPLES_ICM20948_UORB
	bool "Use UORB interface"
	default n
	depends on UORB
	---help---
		Use UORB interface to access ICM20948 sensor data
endif
